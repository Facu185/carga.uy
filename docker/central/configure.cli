# Configura WildFly (standalone-full.xml) en modo embebido, sin arrancar el server.
embed-server --server-config=standalone-full.xml --std-out=echo

# --- Driver PostgreSQL como modulo ---
module add --name=org.postgresql \
  --resources=/tmp/postgresql.jar \
  --dependencies=jakarta.transaction.api

/subsystem=datasources/jdbc-driver=postgresql:add( \
  driver-name=postgresql, \
  driver-module-name=org.postgresql, \
  driver-class-name=org.postgresql.Driver, \
  driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)

# --- Datasource CargaDS ---
# Los valores vienen del entorno; los default son los de docker-compose.
# La configuracion del pool tolera bases que se suspenden por inactividad
# (Neon y otras serverless), pensando en el despliegue en la nube:
#  - min-pool-size=0 + idle-timeout-minutes=1: no retiene conexiones ociosas.
#  - validate-on-match + check-valid-connection-sql: valida antes de entregar.
#  - exception-sorter: ante un error fatal descarta la conexion en vez de reusarla.
/subsystem=datasources/data-source=CargaDS:add( \
  jndi-name=java:jboss/datasources/CargaDS, \
  driver-name=postgresql, \
  connection-url=${env.DB_URL:jdbc:postgresql://db:5432/carga}, \
  user-name=${env.DB_USER:carga}, \
  password=${env.DB_PASSWORD:carga}, \
  min-pool-size=0, \
  max-pool-size=20, \
  pool-prefill=false, \
  idle-timeout-minutes=1, \
  validate-on-match=true, \
  background-validation=false, \
  check-valid-connection-sql="SELECT 1", \
  exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter, \
  enabled=true)

# La cola JMS de posiciones la crea la anotacion @JMSDestinationDefinition del MDB
# (ver PosicionMDB), por eso no se declara aca.

# --- Mensajeria de posiciones (frente P4) ---
# Si PosicionMDB no puede guardar una posicion (por ejemplo, la base no responde) deshace la
# transaccion y Artemis la vuelve a entregar: hasta 5 intentos, esperando 1 s, 2 s, 4 s... (tope 30 s).
# Despues va a la DLQ que ya trae WildFly, en vez de reintentarse para siempre.
# Tamaño y paginado: los mismos valores del address-setting "#" de standalone-full, para no cambiar
# el comportamiento actual. La politica de saturacion definitiva se decide aparte (paso 2 de P4).
/subsystem=messaging-activemq/server=default/address-setting=jms.queue.cola_posiciones:add( \
  dead-letter-address=jms.queue.DLQ, \
  expiry-address=jms.queue.ExpiryQueue, \
  max-delivery-attempts=5, \
  redelivery-delay=1000, \
  redelivery-multiplier=2.0, \
  max-redelivery-delay=30000, \
  max-size-bytes=10485760, \
  page-size-bytes=2097152, \
  address-full-policy=PAGE)
# Habilita la administracion JMX de Artemis: de ahi saca MonitorColaPosiciones cuantas posiciones
# esperan en la cola (metrica carga_tracking_cola_pendientes).
/subsystem=messaging-activemq/server=default:write-attribute(name=jmx-management-enabled, value=true)

# --- Estadisticas del pool de conexiones (frente P4) ---
# MonitorRecursos las lee por JMX y las publica en /carga/api/metricas para la prueba de performance.
/subsystem=datasources/data-source=CargaDS:write-attribute(name=statistics-enabled, value=true)

# --- Direccion publicada en los WSDL ---
# Sin esto WildFly publica la IP interna del contenedor y el WSDL no sirve para
# clientes externos (SoapUI, la PDI, el despliegue en la nube).
/subsystem=webservices:write-attribute(name=wsdl-host, value=jbossws.undefined.host)
/subsystem=webservices:write-attribute(name=modify-wsdl-address, value=true)

# --- Seguridad (frente P1) ---
# La autenticacion la hace MecanismoJwt (Jakarta Security) con usuarios que no estan en ningun
# realm de WildFly: sin esto Elytron intenta validarlos contra el realm y rechaza el ingreso.
/subsystem=undertow/application-security-domain=other:write-attribute(name=integrated-jaspi, value=false)

# --- Observabilidad (frente P1, Seccion 4.4 punto 7 de la letra) ---
# Logs estructurados (JSON) en la consola. Incluyen el MDC, donde esta el ID de correlacion
# ("idCorrelacion") y el usuario del pedido.
/subsystem=logging/json-formatter=JSON:add(pretty-print=false, exception-output-type=formatted, meta-data={servicio=central})
/subsystem=logging/console-handler=CONSOLE:write-attribute(name=named-formatter, value=JSON)
# El log de acceso de cada pedido (FiltroCorrelacion) va en INFO
/subsystem=logging/logger=uy.edu.fing.tse.carga:add(level=INFO)

# --- La raiz del servidor ---
# Dos filtros con condiciones EXCLUYENTES, para no depender del orden en que WildFly los aplica.
# 1) Vuelta del ingreso con gub.uy. ID Uruguay solo redirige a URIs registradas exactas y la nuestra
#    es http://localhost:8080 (sin ruta y sin barra final: con barra la rechaza), asi que el codigo
#    llega a la raiz: se reenvia al callback
#    conservando los parametros (%q = "?code=...&state=...").
/subsystem=undertow/configuration=filter/expression-filter=raiz-callback-gubuy:add(expression="path('/') and (exists('%{q,code}') or exists('%{q,error}')) -> redirect('/carga/api/auth/gubuy/callback%q')")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=raiz-callback-gubuy:add()
# 2) Cualquier otra visita a la raiz lleva a la aplicacion. Sin esto, http://localhost:8080/ muestra
#    la pagina de bienvenida de WildFly y parece que no hubiera nada desplegado.
/subsystem=undertow/configuration=filter/expression-filter=raiz-a-carga:add(expression="path('/') and not (exists('%{q,code}') or exists('%{q,error}')) -> redirect('/carga/')")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=raiz-a-carga:add()

stop-embedded-server
