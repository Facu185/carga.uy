# Copiar a .env (docker compose lo lee solo). NO se versiona.
DB_NAME=carga
DB_USER=carga
DB_PASSWORD=carga

# Puerto publicado en el equipo; PostgreSQL mantiene el 5432 dentro de Docker.
# Cambiar en .env si el puerto local esta ocupado (por ejemplo, 55432).
DB_PORT=5432

# Frecuencia con la que el nodo Tracking envia posiciones (ms)
TRACKING_INTERVALO_MS=5000
# Saturacion de la ingesta de posiciones (ADR-0008). Descomentar solo para probar con otros valores.
# TRACKING_COLA_UMBRAL_ALTO=18000
# TRACKING_COLA_UMBRAL_BAJO=9000
# TRACKING_REINTENTAR_SEG=30
# TRACKING_LOTE_MAX=500

# --- Seguridad (frente P1) ---
# Los default de docker-compose sirven SOLO para desarrollo. En la nube, definir todos.
# JWT_SECRET: al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_DURACION_MINUTOS=30
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=
# Backoffice: bd (default) o ldap
AUTENTICACION_INTERNA=bd
# gub.uy: por defecto el simulador. Para testing real ver docs/integracion-id-uruguay-testing.md.
# El override docker-compose.gubuy-testing.yml exige un secreto no vacio en .env.
GUBUY_CLIENT_SECRET=
# LDAP opcional: descomentar para levantar el directorio y usarlo en el backoffice
# COMPOSE_PROFILES=ldap
# AUTENTICACION_INTERNA=ldap

# --- Ingreso con gub.uy contra el ambiente de TESTING de ID Uruguay (opcional) ---
# Recomendado: usar docker-compose.gubuy-testing.yml junto al Compose base y completar SOLO
# GUBUY_CLIENT_SECRET en .env con el secreto vigente/rotado. No lo copies a este archivo versionado.
# Alternativa sin override: definir TODAS las siguientes variables en .env, sin duplicar claves.
# GUBUY_ISSUER=https://auth-testing.iduruguay.gub.uy/oidc/v1
# GUBUY_AUTHORIZATION_ENDPOINT=
# GUBUY_CLIENT_ID=890192
# GUBUY_CLIENT_SECRET=<pedirlo al grupo>
# SIN barra final: con barra ID Uruguay rechaza el pedido (OIDC_ERROR).
# GUBUY_REDIRECT_URI=http://localhost:8080
# GUBUY_SCOPES=openid personal_info email document

# --- Tokens de los nodos perifericos (ADR-0007) ---
# El nodo Tracking se identifica ante el central y el central ante el nodo Balanzas con un token
# compartido. Los valores por defecto son de desarrollo: en la nube, valores largos y aleatorios.
# NODO_TRACKING_TOKEN=tracking-solo-desarrollo
# NODO_BALANZAS_TOKEN=balanzas-solo-desarrollo

# ---------------------------------------------------------------------------------------------
# Elastic Cloud (paquete "Docker Engine CE" -> "Deploy containers from compose.yml").
# En el servidor, crear .env en la carpeta del proyecto con estas lineas (reemplazar <entorno>)
# y volver a levantar con: docker-compose up -d --build
# FRONTEND_PUERTO=80
# FRONTEND_URL_WEB=https://<entorno>.web.elasticloud.uy
# El simulador de gub.uy (8085) no pasa por el dominio con SSL: hace falta la IP publica del nodo
# GUBUY_AUTHORIZATION_ENDPOINT=http://<IP publica>:8085/gubuy/authorize
# GUBUY_REDIRECT_URI=https://<entorno>.web.elasticloud.uy/carga/api/auth/gubuy/callback
# JWT_SECRET=<una clave larga y aleatoria>
# ADMIN_INICIAL_PASSWORD=<una clave propia, no la de desarrollo>
