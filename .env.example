# Copiar a .env (docker compose lo lee solo). NO se versiona.
DB_NAME=carga
DB_USER=carga
DB_PASSWORD=carga

# Frecuencia con la que el nodo Tracking envia posiciones (ms)
TRACKING_INTERVALO_MS=5000

# --- Seguridad (frente P1) ---
# Los default de docker-compose sirven SOLO para desarrollo. En la nube, definir todos.
# JWT_SECRET: al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_DURACION_MINUTOS=30
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_PASSWORD=
# Backoffice: bd (default) o ldap
AUTENTICACION_INTERNA=bd
# gub.uy: por defecto el simulador. Para ID Uruguay real: issuer, client id/secret y redirect de testing
GUBUY_CLIENT_SECRET=
# LDAP opcional: descomentar para levantar el directorio y usarlo en el backoffice
# COMPOSE_PROFILES=ldap
# AUTENTICACION_INTERNA=ldap
